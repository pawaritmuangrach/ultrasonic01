# ---------------------------------------------------------------- ชุดข้อมูล
# car/data/ คือ 539 MB (6,442 npz + 6,615 ภาพ depth) — ใหญ่เกินกว่าจะเก็บใน git
# ข้อมูลดิบเก็บไว้ในเครื่องและสำรองแยกต่างหาก · โค้ดที่สร้างและอ่านมันอยู่ใน repo แล้ว
# ถ้าอยากแชร์ให้คนอื่นทำซ้ำได้ ให้ zip เฉพาะ 1 ช่วงแล้วแนบใน Releases แทน
car/data/

# แคชที่สร้างใหม่ได้จากข้อมูลดิบ
car/data/_*_cache.npz

# --------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ------------------------------------------------------- ภาพที่โปรแกรมเซฟตอนรัน
# check.py / predict.py กด s แล้วเซฟลงโฟลเดอร์ปัจจุบัน — เป็นภาพชั่วคราว ไม่ใช่ผลงาน
check_*.png
predict_*.png
cloud_*.png

# ------------------------------------------------------------------ ระบบ
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.bak

# ----------------------------------------------------- ภาพแฟลชเต็มของบอร์ด ESP32
# esp32_array/_backup/ คือภาพแฟลชทั้งชิป (4-16 MB ต่อไฟล์) ไว้กู้เฟิร์มแวร์เดิมคืนเท่านั้น
# ไม่ใส่ใน git: ใหญ่เกินไป และภาพแฟลชของบอร์ดที่ไม่ใช่โปรเจกต์นี้อาจมีชื่อ/รหัสไวไฟฝังอยู่
esp32_array/_backup/

# ชุดสำหรับ Colab สร้างใหม่ได้ด้วย python colab/build_colab.py (มีข้อมูล 115 MB อยู่ข้างใน)
colab/*.zip

# ชิ้นข้อมูลห้อง D + โค้ด zip สำหรับอัปโหลด Kaggle (46 MB) สร้างใหม่ได้จาก car/data
colab/final_upload/
